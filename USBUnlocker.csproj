<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <RootNamespace>USBUnlocker</RootNamespace>
    <AssemblyName>USBUnlocker</AssemblyName>
    <Version>3.0.0</Version>
    <Authors>Heavenly Keys Team</Authors>
    <Description>Portable Windows IT Diagnostic and Repair Toolkit</Description>
    <AssemblyTitle>Heavenly Keys</AssemblyTitle>
    <Copyright>Copyright 2026</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
